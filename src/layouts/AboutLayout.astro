---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import Socials from "@/components/Socials.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
>
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <header
      class="frame flex flex-col items-start gap-6 pt-4 pb-2 sm:flex-row sm:items-center"
    >
      <img
        src="/assets/profile.jpg"
        alt="Bharathvaj Ganesan, smiling in sunglasses and a navy jacket in front of snowy mountains"
        width="400"
        height="400"
        class="size-24 flex-none rounded-full border border-border object-cover sm:size-28"
      />
      <h1
        class="text-display-s"
        style="overflow-wrap: break-word; min-width: 0;"
      >
        {frontmatter.title}
      </h1>
    </header>
    <div
      class="frame mb-28 lg:grid lg:grid-cols-[minmax(0,36rem)_clamp(15rem,25vw,23rem)] lg:items-start lg:justify-between lg:gap-10"
    >
      <section id="about" class="prose max-w-none prose-img:border-0">
        <slot />
        <Socials />
      </section>
      <figure class="mt-12 lg:sticky lg:top-24 lg:mt-0">
        <img
          src="/assets/us.jpg"
          alt="Two people jumping with their arms up between the split gates of a stone temple, their reflection upside down in the still water below"
          width="1200"
          height="1200"
          loading="lazy"
          class="w-full rotate-3 rounded-2xl border border-border shadow-card hover:rotate-0 motion-safe:transition-transform motion-safe:duration-300"
        />
        <figcaption class="byline mt-3 max-w-[44ch]">
          PS: That’s me and my wife, mid-jump. The upside-down pair in the water
          is not a staging environment. We both landed fine.
        </figcaption>
      </figure>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  html,
  body {
    overflow-x: clip;
  }
  h1 {
    overflow-wrap: break-word;
    min-width: 0;
    text-wrap: balance;
  }
</style>
