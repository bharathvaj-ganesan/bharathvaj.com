---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout
  title={`404 Not Found | ${SITE.title}`}
  description="The page you requested could not be found. Browse Bharathvaj Ganesan's software engineering articles instead."
  noindex
>
  <Header />

  <main id="main-content" class="frame flex flex-1 items-center">
    <div class="mb-14 flex flex-col items-start">
      <h1 class="text-display">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p
        class="mt-4 font-display text-2xl font-semibold tracking-display sm:text-3xl"
      >
        Page Not Found
      </p>
      <LinkButton href="/" class="link my-6 text-lg"> Go back home </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
