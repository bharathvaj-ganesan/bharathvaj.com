---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(
  ({ data }) => data.featured && data.type !== "til"
);
const latestPosts = sortedPosts
  .filter(({ data }) => !data.featured)
  .slice(0, SITE.postPerIndex * 2);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="frame pt-14 pb-14 text-center sm:pt-20 sm:pb-20">
      <h1 class="mx-auto text-display">Hey, I’m Bharath.</h1>
      <p class="mx-auto mt-5 max-w-[34ch] text-lead text-muted">
        I lead AI Engineering at Chargebee and I write here about what I learn along the way."
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/posts/" class="btn btn-primary">Read the posts</a>
        <a href="/about" class="btn btn-secondary">About me</a>
      </div>
    </section>

    <div class="frame space-y-16 pb-20">
      {
        featuredPosts.length > 0 && (
          <section id="featured">
            <div class="flex items-baseline justify-between gap-4 pb-4">
              <h2 class="text-2xl">Featured</h2>
            </div>
            <ul class="index-list">
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        )
      }

      {
        latestPosts.length > 0 && (
          <section id="latest">
            <div class="flex items-baseline justify-between gap-4 pb-4">
              <h2 class="text-2xl">TIL</h2>
              <div class="flex items-baseline gap-5">
                <LinkButton href="/posts/" class="link whitespace-nowrap">
                  All Posts
                </LinkButton>
                <LinkButton href="/til/" class="link whitespace-nowrap">
                  All TILs
                </LinkButton>
              </div>
            </div>
            <ul class="index-list">
              {latestPosts.map(data => (
                <Card variant="h3" showType {...data} />
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <section id="bio" class="border-t border-border">
      <div
        class="frame py-16 sm:py-20 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-x-10"
      >
        <div class="mb-8 lg:mb-0">
          <h2 class="text-2xl">About me</h2>
          <img
            src="/assets/profile.jpg"
            alt="Bharathvaj Ganesan, smiling in sunglasses and a navy jacket in front of snowy mountains"
            width="400"
            height="400"
            loading="lazy"
            class="mt-6 size-32 rounded-full border border-border object-cover"
          />
        </div>
        <div class="max-w-[60ch] space-y-5 text-lead text-ink-2">
          <p>
            I’m a Software Engineer with 8+ years of experience, passionate
            about building purposeful products with deep technical rigor. With a
            background in Computer Science Engineering, my curiosity for how
            systems work has shaped my journey.
          </p>
          <p>
            Currently serving as a <b
              >Senior Lead Software Engineer at <a
                href="https://chargebee.com"
                target="_blank"
                class="link">Chargebee</a
              ></b
            >, where I lead AI Engineering, building intelligent
            Copilots, scalable AI workflows, and a robust AI platform.
          </p>
          <div
            class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-2 text-base"
          >
            {
              SOCIALS.length > 0 && (
                <div class="flex flex-wrap items-center gap-x-2">
                  <span class="whitespace-nowrap">Social Links:</span>
                  <Socials />
                </div>
              )
            }
            <a href="/til/rss.xml" class="link whitespace-nowrap">
              Subscribe via RSS
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer noMarginTop />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
