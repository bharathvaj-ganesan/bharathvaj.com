---
export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
---

<li class:list={["inline-block", size === "sm" ? "my-1 mr-2" : "my-1.5 mr-2"]}>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={["pill", size === "sm" ? "text-sm" : "text-base"]}
  >
    {tagName}
  </a>
</li>
