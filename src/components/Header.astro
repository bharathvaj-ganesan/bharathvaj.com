---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navLink =
  "block rounded-full px-4 py-3 text-center font-medium text-ink-2 hover:bg-paper-2 hover:text-ink lg:px-3 lg:py-1.5";
---

<header class="sticky top-0 z-30 border-b border-border bg-background">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute -top-full left-4 z-50 bg-background px-3 py-2 text-accent focus:top-4"
  >
    Skip to content
  </a>
  <div id="nav-container" class="frame">
    <div
      id="top-nav-wrap"
      class="relative flex h-14 w-full items-center justify-between"
    >
      <a
        href="/"
        class="font-display text-base leading-none font-semibold tracking-display whitespace-nowrap"
      >
        {SITE.title}
      </a>
      <nav id="nav-menu" class="flex items-center lg:ml-8 lg:flex-1">
        <button
          id="menu-btn"
          class="focus-outline rounded-full p-2 hover:bg-paper-2 lg:hidden"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class:list={[
            "absolute top-full right-0 z-40 mt-2 grid w-52 grid-cols-2 place-content-center gap-1 rounded-2xl border border-border bg-background p-2 shadow-card",
            "hidden",
            "lg:static lg:mt-0 lg:flex lg:w-auto lg:flex-1 lg:items-center lg:gap-1 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none",
          ]}
        >
          <li class="col-span-2">
            <a
              href="/posts"
              class:list={[
                navLink,
                { "active-nav": isActive("/posts") || isActive("/til") },
              ]}
            >
              Posts
            </a>
          </li>
          <li class="col-span-2">
            <a
              href="/talks"
              class:list={[navLink, { "active-nav": isActive("/talks") }]}
            >
              Talks
            </a>
          </li>
          <li class="col-span-2">
            <a
              href="/tags"
              class:list={[navLink, { "active-nav": isActive("/tags") }]}
            >
              Tags
            </a>
          </li>
          <li class="col-span-2">
            <a
              href="/about"
              class:list={[navLink, { "active-nav": isActive("/about") }]}
            >
              About
            </a>
          </li>
          <li class="col-span-1 flex items-center justify-center lg:ml-auto">
            <LinkButton
              href="/search"
              class:list={[
                "focus-outline flex rounded-full p-3 hover:bg-paper-2 lg:p-2",
                { "[&>svg]:stroke-accent": isActive("/search") },
              ]}
              ariaLabel="search"
              title="Search"
            >
              <IconSearch />
              <span class="sr-only">Search</span>
            </LinkButton>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 rounded-full p-4 hover:bg-paper-2 lg:size-9"
                  title="Toggles light & dark"
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 motion-safe:transition-transform dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 motion-safe:transition-transform dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
          {
            SITE.showArchives && (
              <li class="col-span-2 lg:ml-1">
                <LinkButton
                  href="/archives"
                  class:list={[
                    "pill focus-outline block w-full text-center",
                    { "active-nav": isActive("/archives") },
                  ]}
                  ariaLabel="archives"
                  title="Archives"
                >
                  <IconArchive class="mr-1 hidden size-4 lg:inline-block" />
                  <span>Archives</span>
                </LinkButton>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
